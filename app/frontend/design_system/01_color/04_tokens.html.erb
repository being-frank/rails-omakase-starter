<%= vite_stylesheet_tag 'application.css', 'data-turbo-track': :reload %>
<%= render 'kitsune_ds/pages/kdsdocs_styles', styles_for: %i[states tokens variants] %>

<%
KitsuneDS::DesignTokens.new.semantic.select { |t| t.theme != 'dark' }.group_by(&:role).each do |role, role_tokens|
  emphasis_tokens = role_tokens.group_by(&:emphasis)
  emphasis_tokens.each do |emphasis, tokens|
%>
    <h3><%= role %> - <%= emphasis %></h3>
    <table class='kdsdocs-table'>
      <thead>
        <tr>
          <th class='-center'>set</th>
          <th class='-center'>system</th>
          <th class='-center'>component</th>
          <th class='-center'>category</th>
          <th class='-center'>property</th>
          <th class='-center'>role</th>
          <th class='-center'>variant</th>
          <th class='-center'>emphasis</th>
          <th class='-center'>scale</th>
          <th class='-center'>state</th>
          <th class='-center'>theme</th>
        </tr>
      </thead>
      <tbody>
        <% tokens.each do |token| %>
          <tr>
            <td class='-center'><tt style='font-size:10px'><%= token.set %></tt></td>
            <td class='-center'><tt style='font-size:10px'><%= token.system %></tt></td>
            <td class='-center'><tt style='font-size:10px'><%= token.component %></tt></td>
            <td class='-center'><tt style='font-size:10px'><%= token.category %></tt></td>
            <td class='-center'><tt style='font-size:10px'><%= token.property %></tt></td>
            <td class='-center'><tt style='font-size:10px'><%= token.role %></tt></td>
            <td class='-center'><tt style='font-size:10px'><%= token.variant %></tt></td>
            <td class='-center'><tt style='font-size:10px'><%= token.emphasis %></tt></td>
            <td class='-center'><tt style='font-size:10px'><%= token.scale %></tt></td>
            <td class='-center'><tt style='font-size:10px'><%= token.state %></tt></td>
            <td class='-center'><tt style='font-size:10px'><%= token.theme %></tt></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>
