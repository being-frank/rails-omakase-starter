# ==== Environment

RAILS_ENV=development
NODE_ENV=${RAILS_ENV}
X_APP_ENV=${RAILS_ENV}

# ==== Rails

PORT=3000
SOLID_QUEUE_IN_PUMA=true

# ==== Database

DATABASE_URL=postgres://${USER}@localhost:5432/rails_quick_start_development

# ==== Overmind

OVERMIND_PORT=${PORT}
OVERMIND_PROCFILE=Procfile.dev
