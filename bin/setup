#!/usr/bin/env ruby
require 'fileutils'

APP_ROOT = File.expand_path('..', __dir__)

def system!(*args)
  system(*args, exception: true)
end

def section(name)
  puts "\n==== #{name} ====\n\n"
end

FileUtils.chdir APP_ROOT do
  edit_files = []

  section('Installing libraries')
  system('brew bundle install')

  section('Installing Ruby gems')
  system!('gem install bundler --conservative')
  system('bundle check') || system!('bundle install')

  section('Installing Javascript packages')
  system!('yarn install')

  if !File.exist?('.env')
    section('Copying .env.sample')
    FileUtils.cp('.env.sample', '.env')
    edit_files.push('.env')
  end

  if !File.exist?('config/master.key')
    system!('touch config/master.key')
    edit_files.push('config/master.key')
  end

  %i[staging production].each do |env|
    if !File.exist?("config/credentials/#{env}.key")
      system!("touch config/credentials/#{env}.key")
      edit_files.push("config/credentials/#{env}.key")
    end
  end

  section('Preparing database')
  system!('bin/rails db:prepare')

  section('Removing old logs and tempfiles')
  system!('bin/rails log:clear tmp:clear')

  puts "✅ Done! ✅\n"

  if edit_files.any?
    puts "\nEdit the following files to configure the local environment:\n\n"
    edit_files.each do |file|
      puts "  - #{file}"
    end
    puts "\nOnce complete, run `bin/dev` to start the development server.\n"
  end
end
