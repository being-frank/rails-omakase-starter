#!/usr/bin/env ruby
require 'fileutils'

APP_ROOT = File.expand_path('..', __dir__)

def system!(*args)
  system(*args, exception: true)
end

def section(name)
  puts "\n🔵 #{name}\n\n"
end

FileUtils.chdir APP_ROOT do
  edit_files = []

  section('Libraries via Homebrew')
  system!('brew bundle install')

  section('Bundler and Ruby gems')
  system!('gem install bundler --conservative')
  system('bundle check') || system!('bundle install')

  section('Javascript packages')
  system!('bun install')

  if !File.exist?('.env')
    section('Setup `.env`')
    FileUtils.cp('.env.sample', '.env')
    edit_files.push('.env')
  end

  section('Credentials')
  %i[development staging production].each do |env|
    credential_key     = "config/credentials/#{env}.key"
    credential_content = "config/credentials/#{env}.yml.enc"

    if File.exist?(credential_key)
      FileUtils.rm_f(credential_key)
    end

    if File.exist?(credential_content)
      FileUtils.rm_f(credential_content)
    end
  end

  section('Database')
  system!('bin/rails db:prepare')

  section('Cleanup')
  system!('bin/rails log:clear tmp:clear')

  puts "✅ Done!\n"

  if edit_files.any?
    puts "\nEdit the following files to configure the local environment:\n\n"
    edit_files.each do |file|
      puts "  - #{file}"
    end
    puts "\nOnce complete, run `bin/dev` to start the development server.\n"
  end
end
